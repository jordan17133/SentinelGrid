table 'rpt cases'
	lineageTag: 216efbd1-822f-5954-bc64-bbe8848b74a9

	measure Cases = COUNTROWS('rpt cases') + 0
		formatString: #,0
		lineageTag: f3b664f4-a4cd-51d7-b951-ce396dee16ca

	measure 'Open cases' = CALCULATE([Cases], 'rpt cases'[status] <> "Closed")
		formatString: #,0
		lineageTag: e9c2cbe1-d356-5f8b-978a-d65c062d7888

	measure 'Closed cases' = CALCULATE([Cases], 'rpt cases'[status] = "Closed")
		formatString: #,0
		lineageTag: 9915eebb-bf13-51ad-85f2-5c25386609b3

	measure 'True positives' = CALCULATE([Cases], 'rpt cases'[verdict] = "True positive")
		formatString: #,0
		lineageTag: 381ffc11-e782-5e63-86aa-ff6f84f7f06c

	measure 'Median hours to verdict' = MEDIAN('rpt cases'[hours_to_verdict])
		formatString: 0.0 "h"
		lineageTag: d80bc314-bb13-585a-9b94-568f4622f4fa

	measure 'Hours to verdict' = SUM('rpt cases'[hours_to_verdict])
		formatString: 0.0
		lineageTag: b35e9615-aaa5-5b93-8fb4-1a6c2f0faf4b

