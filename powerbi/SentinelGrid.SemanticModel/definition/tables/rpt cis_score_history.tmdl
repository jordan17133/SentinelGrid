table 'rpt cis_score_history'
	lineageTag: 520de8b3-d062-57dd-9c98-38a951415478

	measure 'CIS score' = DIVIDE(AVERAGE('rpt cis_score_history'[score_pct]), 100)
		formatString: 0.0%
		lineageTag: 39c28a1c-2c4f-58c2-a4c5-3c15e866a2ce

	measure 'CIS score now' =
			VAR latestScan = TOPN(1, 'rpt cis_score_history', 'rpt cis_score_history'[scan_time_local], DESC)
			RETURN DIVIDE(MAXX(latestScan, 'rpt cis_score_history'[score_pct]), 100)
		formatString: 0.0%
		lineageTag: dafbbaf5-eda4-50e5-8f78-b4cf158cacfb

	measure 'CIS score at baseline' =
			VAR firstScan = TOPN(1, 'rpt cis_score_history', 'rpt cis_score_history'[scan_time_local], ASC)
			RETURN DIVIDE(MAXX(firstScan, 'rpt cis_score_history'[score_pct]), 100)
		formatString: 0.0%
		lineageTag: 20f42058-88a8-5ea3-89dd-f18c8c66db30

