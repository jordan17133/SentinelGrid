table 'rpt attack_coverage'
	lineageTag: 3e3081d6-2489-5c51-a63a-0b2eae91fe68

	measure Techniques = DISTINCTCOUNT('rpt attack_coverage'[technique_id]) + 0
		formatString: #,0
		lineageTag: fc369d9d-a316-5736-af9e-8442e484322a

	measure 'Techniques with a ready rule' = CALCULATE([Techniques], 'rpt attack_coverage'[coverage_sort] <= 2)
		formatString: #,0
		lineageTag: 8d99b469-0d93-5497-9657-3a2b8b57170c

	measure 'Rule coverage' = DIVIDE([Techniques with a ready rule], [Techniques])
		formatString: 0%
		lineageTag: 969f50db-736f-5811-b2af-54d5d458898a

