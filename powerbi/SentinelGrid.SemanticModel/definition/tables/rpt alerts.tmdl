table 'rpt alerts'
	lineageTag: 7682a6e8-89ca-45fb-8512-ba0519fd0a0e

	measure 'Total Alerts' = COUNTROWS('rpt alerts')
		formatString: 0
		lineageTag: af15fd3b-66a1-4371-8844-593be34a9f94

	measure 'Critical Alerts' = CALCULATE([Total Alerts], 'rpt alerts'[severity_band] = "Critical")
		formatString: 0
		lineageTag: cab208d6-fded-4187-83fd-2c5848ddcb8a

	measure 'High Alerts' = CALCULATE([Total Alerts], 'rpt alerts'[severity_band] = "High")
		formatString: 0
		lineageTag: 660e26e9-a8ba-4932-9782-f680dcb1132f

	measure 'Medium Alerts' = CALCULATE([Total Alerts], 'rpt alerts'[severity_band] = "Medium")
		formatString: 0
		lineageTag: c6c21626-4369-4666-83d3-0c59bd51a4ab

	measure 'Low Alerts Display' = FORMAT([Low Alerts], "#,0")
		lineageTag: ed7d8b44-2814-403c-9956-f4e41a460215

	measure 'Low Alerts' = CALCULATE([Total Alerts], 'rpt alerts'[severity_band] = "Low")
		formatString: 0
		lineageTag: 63044d2f-be24-4ffa-882f-33af2fc3b0ab

	measure 'Alerts 24h Display' = FORMAT(CALCULATE([Total Alerts] + 0, 'rpt alerts'[alert_time_local] >= NOW() - 1), "#,0")
		lineageTag: 04f86ba2-81a8-5d55-b08c-d45fad0f1260

	measure 'Medium Alerts Display' = FORMAT([Medium Alerts] + 0, "#,0")
		lineageTag: e0d2a306-6721-5a54-8617-a3a5eb72853a

	measure 'High Alerts Display' = FORMAT([High Alerts] + 0, "#,0")
		lineageTag: 696f39a3-1471-505b-967a-ee680ba8b1fb

	measure 'Critical Alerts Display' = FORMAT([Critical Alerts] + 0, "#,0")
		lineageTag: 8891e3a3-2507-579c-891d-5fd9c075c336

	measure 'Total Alerts Display' = FORMAT([Total Alerts], "#,0")
		lineageTag: 3d4ff0e0-6bad-554f-9680-7abcbffb1cfa

