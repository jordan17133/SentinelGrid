table 'rpt pipeline_status'
	lineageTag: ad2b4f34-3739-5f4a-b562-279d02192fb9

	measure 'Minutes since last load' = MAX('rpt pipeline_status'[minutes_since_success])
		formatString: #,0
		lineageTag: f54a0445-8b63-5730-9695-3daf1192b186

	measure 'Loader success 7d' = DIVIDE(MAX('rpt pipeline_status'[success_rate_7d_pct]), 100)
		formatString: 0.0%
		lineageTag: 9bbf0213-4bea-5619-8751-86ae1ae3f0bc

	measure 'Median latency' = MAX('rpt pipeline_status'[latency_p50_minutes_7d])
		formatString: 0.0 "min"
		lineageTag: acc16318-9f08-530b-9338-0b4caa649a48

	measure '95th pct latency' = MAX('rpt pipeline_status'[latency_p95_minutes_7d])
		formatString: 0.0 "min"
		lineageTag: 71990a79-54d4-53c4-8abe-09a712088f72

	measure 'Alerts loaded 24h' = FORMAT(MAX('rpt pipeline_status'[alerts_loaded_24h]), "#,0")
		lineageTag: 52c04e83-efe8-5cf8-90f0-18a10545fac3

	measure 'Data as of' = "Data as of " & FORMAT(MAX('rpt pipeline_status'[as_of_local]), "yyyy-mm-dd h:nn AM/PM") & " (US Eastern)"
		lineageTag: d4751801-761c-57c5-91bf-a957b7c10680

	measure 'Warehouse size' = MAX('rpt pipeline_status'[data_used_mb])
		formatString: #,0 "MB"
		lineageTag: dc41c328-2274-5d18-b85b-92bcec66e5b5

