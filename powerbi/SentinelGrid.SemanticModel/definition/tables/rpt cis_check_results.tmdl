table 'rpt cis_check_results'
	lineageTag: b9b69b01-ad93-581b-8008-2b2d729aa9bb

	measure Checks = COUNTROWS('rpt cis_check_results') + 0
		formatString: #,0
		lineageTag: 9db23ed5-c7c7-525c-9785-4ff5543f183c

	measure 'Checks fixed' = CALCULATE([Checks], 'rpt cis_check_results'[change_status] = "Fixed")
		formatString: #,0
		lineageTag: d1c4ffab-6226-5962-b17c-9a6e37f77cd6

	measure 'Checks regressed' = CALCULATE([Checks], 'rpt cis_check_results'[change_status] = "Regressed")
		formatString: #,0
		lineageTag: f3433fbe-1d3e-5e56-9afb-8038ae7b071f

	measure 'Passing at baseline' =
			DIVIDE(CALCULATE([Checks], 'rpt cis_check_results'[baseline_result] = "passed"),
			CALCULATE([Checks], 'rpt cis_check_results'[baseline_result] IN {"passed", "failed"}))
		formatString: 0%
		lineageTag: c00f8818-c1dc-5f91-8ceb-20f788955778

	measure 'Passing now' =
			DIVIDE(CALCULATE([Checks], 'rpt cis_check_results'[current_result] = "passed"),
			CALCULATE([Checks], 'rpt cis_check_results'[current_result] IN {"passed", "failed"}))
		formatString: 0%
		lineageTag: dcb1d226-a1e5-5b57-b78e-7ddec352fc0f

