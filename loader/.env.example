# Copy to loader/.env (git-ignored) and fill in the password.
# The loader account must be read-only: it only needs to search
# wazuh-alerts-* and wazuh-states-vulnerabilities-*. Never use admin here.

# The Indexer listens only on the VM's loopback address, so the loader reaches it
# through an SSH tunnel. The key is restricted on the VM (authorized_keys) to
# forwarding 127.0.0.1:9200: no shell, no commands.
SSH_TUNNEL_TARGET=j0dane@wazuh.mshome.net
SSH_KEY_FILE=C:\Users\Jordan\.ssh\sentinelgrid_loader
SSH_TUNNEL_LOCAL_PORT=19200

WAZUH_INDEXER_URL=https://127.0.0.1:19200
WAZUH_INDEXER_USER=sentinelgrid_loader
WAZUH_INDEXER_PASSWORD=

# Wazuh root CA, extracted from the private wazuh-install-files.tar backup.
# The Indexer certificate is issued for 127.0.0.1, which matches the tunnel URL,
# so TLS is fully verified.
WAZUH_CA_FILE=C:\Users\Jordan\Documents\SentinelGrid-Private\wazuh-install-files\root-ca.pem

# Optional. Defaults to Windows authentication against the local default instance.
# SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=SentinelGridWarehouse;Trusted_Connection=yes;TrustServerCertificate=yes
